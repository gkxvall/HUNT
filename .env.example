# =========================
# Local LLM Configuration
# =========================

OLLAMA_MODEL=llama3.1:8b

# =========================
# Sending Email Configuration
# =========================

EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# =========================
# Applicant Identity
# Leave empty values unused.
# =========================

APPLICANT_FULL_NAME=
APPLICANT_PREFERRED_NAME=
APPLICANT_NATIONALITY=
APPLICANT_CURRENT_LOCATION=
APPLICANT_TIMEZONE=
APPLICANT_SHORT_BIO=

# =========================
# Applicant Contact
# Leave empty values unused.
# =========================

APPLICANT_PERSONAL_EMAIL=
APPLICANT_PHONE=
APPLICANT_WHATSAPP=
APPLICANT_TELEGRAM=
APPLICANT_DISCORD=

# =========================
# Applicant Links
# Leave empty values unused.
# =========================

APPLICANT_PORTFOLIO_URL=
APPLICANT_BLOG_URL=
APPLICANT_GITHUB_URL=
APPLICANT_LINKEDIN_URL=
APPLICANT_KAGGLE_URL=
APPLICANT_GOOGLE_SCHOLAR_URL=
APPLICANT_ORCID_URL=
APPLICANT_MEDIUM_URL=
APPLICANT_DEVTO_URL=
APPLICANT_YOUTUBE_URL=
APPLICANT_PERSONAL_WEBSITE_URL=

# =========================
# Applicant Education
# Leave empty values unused.
# =========================

APPLICANT_UNIVERSITY=
APPLICANT_FACULTY=
APPLICANT_DEPARTMENT=
APPLICANT_DEGREE=
APPLICANT_YEAR_LEVEL=
APPLICANT_EXPECTED_GRADUATION=
APPLICANT_GPA=
APPLICANT_GPA_SCALE=
APPLICANT_RELEVANT_COURSEWORK=
APPLICANT_ACADEMIC_ADVISOR=
APPLICANT_UNIVERSITY_COUNTRY=
APPLICANT_UNIVERSITY_CITY=

# =========================
# Applicant Skills and Interests
# Leave empty values unused.
# Use comma-separated values where useful.
# =========================

APPLICANT_MAIN_INTERESTS=
APPLICANT_TECHNICAL_SKILLS=
APPLICANT_PROGRAMMING_LANGUAGES=
APPLICANT_FRAMEWORKS=
APPLICANT_TOOLS=
APPLICANT_RESEARCH_INTERESTS=
APPLICANT_SOFT_SKILLS=
APPLICANT_LANGUAGES=

# =========================
# Applicant Projects / Experience Highlights
# Leave empty values unused.
# These are optional extra highlights beyond the CV.
# Use them only if provided.
# =========================

APPLICANT_TOP_PROJECT_1_NAME=
APPLICANT_TOP_PROJECT_1_URL=
APPLICANT_TOP_PROJECT_1_DESCRIPTION=
APPLICANT_TOP_PROJECT_2_NAME=
APPLICANT_TOP_PROJECT_2_URL=
APPLICANT_TOP_PROJECT_2_DESCRIPTION=
APPLICANT_TOP_PROJECT_3_NAME=
APPLICANT_TOP_PROJECT_3_URL=
APPLICANT_TOP_PROJECT_3_DESCRIPTION=

APPLICANT_TOP_EXPERIENCE_1_TITLE=
APPLICANT_TOP_EXPERIENCE_1_ORGANIZATION=
APPLICANT_TOP_EXPERIENCE_1_DESCRIPTION=
APPLICANT_TOP_EXPERIENCE_2_TITLE=
APPLICANT_TOP_EXPERIENCE_2_ORGANIZATION=
APPLICANT_TOP_EXPERIENCE_2_DESCRIPTION=

# =========================
# Internship Preferences
# Leave empty values unused unless they are option variables with defaults.
# For variables with options, keep the allowed options in comments.
# =========================

INTERNSHIP_MODE=remote # options: remote, on-site, hybrid, flexible
INTERNSHIP_TYPE=internship # options: internship, summer internship, mandatory internship, voluntary internship, research internship, part-time internship
INTERNSHIP_FIELD_PREFERENCES=
INTERNSHIP_TARGET_ROLES=
INTERNSHIP_AVAILABILITY_START=
INTERNSHIP_AVAILABILITY_END=
INTERNSHIP_DURATION=
INTERNSHIP_HOURS_PER_WEEK=
INTERNSHIP_RELOCATION_OPEN=false # options: true, false
INTERNSHIP_WORK_AUTHORIZATION=
INTERNSHIP_VISA_STATUS=
INTERNSHIP_UNIVERSITY_REQUIREMENT=true # options: true, false
INTERNSHIP_INSURANCE_COVERED_BY_UNIVERSITY=true # options: true, false
INTERNSHIP_REMOTE_REASON=
INTERNSHIP_NOTE=

# =========================
# Email Style Configuration
# Variables with options must show the options as comments.
# =========================

EMAIL_LANGUAGE=English
EMAIL_ACADEMIC_LEVEL=B # options: A, B, C
EMAIL_TONE=professional # options: professional, warm, confident, humble, startup, research-focused, formal, friendly
EMAIL_LENGTH=medium # options: short, medium, long
EMAIL_MAX_WORDS=350
EMAIL_FORMAT=full # options: compact, full
EMAIL_GREETING_STYLE=team # options: team, hiring-team, recruiter, formal
EMAIL_SIGNATURE_STYLE=compact # options: minimal, compact, detailed
EMAIL_INCLUDE_SUBJECT_KEYWORDS=true # options: true, false
EMAIL_INCLUDE_CV_ATTACHMENT_NOTE=true # options: true, false
EMAIL_INCLUDE_UNIVERSITY_REQUIREMENT=true # options: true, false
EMAIL_INCLUDE_INSURANCE_NOTE=true # options: true, false
EMAIL_INCLUDE_LINKS=true # options: true, false
EMAIL_INCLUDE_PHONE=true # options: true, false
EMAIL_INCLUDE_LOCATION=false # options: true, false
EMAIL_INCLUDE_GPA=true # options: true, false
EMAIL_INCLUDE_LANGUAGES=true # options: true, false
EMAIL_INCLUDE_AVAILABILITY=true # options: true, false
EMAIL_INCLUDE_REMOTE_REASON=true # options: true, false

# =========================
# Batch / Campaign Configuration
# =========================

BATCH_DEFAULT_DELAY_SECONDS=20
BATCH_DEFAULT_LIMIT=20
BATCH_ALLOW_DUPLICATES=false # options: true, false
BATCH_SKIP_EXISTING=true # options: true, false
BATCH_SAVE_DRAFTS=true # options: true, false
